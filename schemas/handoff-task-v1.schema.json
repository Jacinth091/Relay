{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/handoff-task-v1.schema.json",
  "title": "Relay Handoff Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "project",
    "title",
    "task"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "stack": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ambiguity_policy": {
      "type": "string",
      "enum": [
        "needs_input"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
